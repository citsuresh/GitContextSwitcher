<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
              <UseWPF>true</UseWPF>
              <UseWindowsForms>true</UseWindowsForms>
              <!-- Ensure public NuGet (nuget.org) is considered when private feeds require authentication -->
              <RestoreSources>https://api.nuget.org/v3/index.json;$(RestoreSources)</RestoreSources>
              <ApplicationIcon>app_icon.ico</ApplicationIcon>
            </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <!-- Use DiffPlex.Wpf latest compatible resolved version and align DiffPlex package version to avoid downgrade errors -->
    <PackageReference Include="DiffPlex.Wpf" Version="1.9.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitContextSwitcher.Core\GitContextSwitcher.Core.csproj" />
    <ProjectReference Include="..\GitContextSwitcher.Infrastructure\GitContextSwitcher.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

</Project>
