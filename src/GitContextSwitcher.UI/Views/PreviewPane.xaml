<UserControl x:Class="GitContextSwitcher.UI.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dpw="clr-namespace:DiffPlex.Wpf.Controls;assembly=DiffPlex.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="600"
             xmlns:local="clr-namespace:GitContextSwitcher.UI.Views;assembly=GitContextSwitcher.UI">
    <Border BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="6" Background="#FFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="#EEE" BorderThickness="1" Padding="4">
                    <TreeView ItemsSource="{Binding FileTree}" SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <!-- Use the same glyph + colored-foreground approach as the PendingTreeView -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                              <TextBlock Text="{Binding DisplayIcon}" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding IconBrush}" />
                              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" ToolTip="{Binding ToolTipText}" />
                            </StackPanel>
                          </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <Border Grid.Column="2" BorderBrush="#EEE" BorderThickness="1" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: optional warning banner -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 1: header (Old/New file names) -->
                                <RowDefinition Height="Auto" />
                                <!-- Row 2: diff viewer -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch">
                                <TextBlock Text="Old:" FontWeight="Bold" Margin="0,0,8,4" />
                                <TextBlock Text="{Binding DiffOldPath}" FontStyle="Italic" FontSize="11" Foreground="Gray" Margin="0,0,16,4" />
                                <TextBlock Text="New:" FontWeight="Bold" Margin="0,0,8,4" />
                                <TextBlock Text="{Binding DiffNewPath}" FontStyle="Italic" FontSize="11" Foreground="Gray" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <Viewbox Width="16" Height="16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Margin="8,0,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Width="18" Height="18" Stroke="#FFCCCCCC" StrokeThickness="3" Canvas.Left="3" Canvas.Top="3" Opacity="0.6" />
                                        <Path Data="M12,3 A9,9 0 1 1 11.99,3" Stroke="#FF1E88E5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                                </StackPanel>
                            </StackPanel>
                            <!-- Side-by-side diff viewer with loading overlay -->
                            <Grid Grid.Row="2">
                                <dpw:SideBySideDiffViewer x:Name="PreviewDiffViewer" />

                                <!-- Full overlay shown while loading the diff -->
                                <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Margin="12" Background="Transparent">
                                            <Viewbox Width="48" Height="48">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Width="18" Height="18" Stroke="#FFCCCCCC" StrokeThickness="3" Canvas.Left="3" Canvas.Top="3" Opacity="0.6" />
                                                    <Path Data="M12,3 A9,9 0 1 1 11.99,3" Stroke="#FF1E88E5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                        <Path.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Path.Triggers>
                                                    </Path>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Loading preview..." FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Warning banner shown when left side is sourced from local repo working-tree -->
                            <Border Grid.Row="0" Background="#FFF8E1" BorderBrush="#FFECBDB0" BorderThickness="1" Padding="8" Visibility="{Binding ShowRepoLeftWarning, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Warning:" FontWeight="Bold" Foreground="#8A6D3B" Margin="0,0,8,0" />
                                    <TextBlock Text="The left/old side is taken from the local repository working tree and may include uncommitted local changes. The committed version may differ." Foreground="#8A6D3B" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="(truncated)" Foreground="DarkOrange" Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,8,0" />
                            <TextBlock Text="(context.json truncated)" Foreground="DarkOrange" Visibility="{Binding ContextJsonTruncated, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,6,8,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
